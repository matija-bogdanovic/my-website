{
  // Cloudflare Workers config: serves this folder as a static site.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mywebsite",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
